{
  "deterministic-done-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|write_to_file|replace_file_content|edit_file|Bash|run_command|bash",
        "type": "command",
        "command": "sh .agents/bin/band --guard",
        "timeout": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "sh .agents/bin/band --hook",
        "timeout": 600
      }
    ]
  }
}
